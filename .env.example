NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=you@example.com
# Only needed for the scheduled weekly report (app/api/cron/weekly-report) —
# it runs with no user session, so it needs the service_role key to read
# across every company. Supabase dashboard -> Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Vercel automatically sends this as a Bearer token to your cron
# route when set, so you can verify the request actually came from Vercel Cron.
CRON_SECRET=a-random-secret-string
